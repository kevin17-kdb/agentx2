# Copy to server/.env and fill in. JWT_SECRET + PORT are required.
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Leave MONGO_URI empty to auto-start an in-memory MongoDB (mongodb-memory-server).
# Set to your Atlas/local URI to use a persistent database instead.
MONGO_URI=

# The Python agent runtime.
AGENT_SERVICE_URL=http://127.0.0.1:8100

# Comma-separated allowed client origins.
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
