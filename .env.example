# ------------------------------------------------------------------
# AgentX 2026 — root environment reference
# Copy to server/.env (local development) or export in your shell.
# The server fails fast if JWT_SECRET or PORT are missing.
# ------------------------------------------------------------------

# Express API
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed by CORS (Vite dev proxy is always allowed).
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave empty to use mongodb-memory-server (in-memory Mongo, auto-seeded demo users).
# Set a real connection string for a persistent database.
MONGO_URI=

# Optional: Discord webhook for the notification agent's calendar/reminder digests.
DISCORD_WEBHOOK_URL=

# Agent service (zero-dependency Python HTTP wrapper on port 8100).
AGENT_SERVICE_URL=http://127.0.0.1:8100

# Optional: Anthropic key enables Claude; without it the agents run in
# deterministic mode (fully offline).
ANTHROPIC_API_KEY=
